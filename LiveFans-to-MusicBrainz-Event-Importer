// ==UserScript==
// @name         MusicBrainz: LiveFans Event Importer
// @namespace    https://www.livefans.jp/
// @version      0.1.0
// @description  LiveFansの公演情報をMusicBrainzのイベント作成フォームへ渡す
// @match        https://www.livefans.jp/events/*
// @grant        GM_openInTab
// @run-at       document-idle
// ==/UserScript==

(() => {
  'use strict';

  const MUSICBRAINZ_EVENT_URL =
    'https://musicbrainz.org/event/create';

  function getText(element) {
    return element?.textContent?.replace(/\s+/g, ' ').trim() || '';
  }

  // 公演日と開演時刻を取得
  function getDateAndTime() {
    const dateElement = document.querySelector('p.date');
    const text = getText(dateElement) || getText(document.body);

    const dateMatch = text.match(
      /(\d{4})[年/.-](\d{1,2})[月/.-](\d{1,2})日?/
    );

    const timeMatch = text.match(
      /(\d{1,2}):(\d{2})\s*開演/
    );

    return {
      year: dateMatch?.[1] || '',
      month: dateMatch?.[2] || '',
      day: dateMatch?.[3] || '',
      time: timeMatch
        ? `${timeMatch[1].padStart(2, '0')}:${timeMatch[2]}`
        : '',
      raw: text
    };
  }

  // 公演タイトルを取得
  function getEventName() {
    const selectors = [
      '.head h4.liveName2 a',
      'h4.liveName2 a',
      '.liveName2 a',
      '.head h4.liveName2'
    ];

    for (const selector of selectors) {
      const name = getText(document.querySelector(selector));

      if (
        name &&
        !name.includes('ライブ・セットリスト情報サービス') &&
        !name.includes('＠')
      ) {
        return name;
      }
    }

    return '';
  }
// 会場名から不要な記号と都道府県名を削除
function cleanVenueName(name) {
  return name
    .replace(/[＠@]/g, '')
    .replace(
      /[\(（]\s*(?:北海道|東京都|大阪府|京都府|.{2,3}県)\s*[\)）]/g,
      ''
    )
    .replace(/\s+/g, ' ')
    .trim();
}
  // 会場名を取得
  function getVenue() {
    const selectors = [
      'a[href*="/venues/"]',
      '.venue a',
      '.venue',
      '.place',
      '.hall'
    ];

    for (const selector of selectors) {
      const element = document.querySelector(selector);
      const name = getText(element);

      if (name && name.length < 150) {
        return cleanVenueName(name);
      }
    }

    // 公演日時周辺から取得する予備処理
    const dateElement = document.querySelector('p.date');

    if (dateElement?.parentElement) {
      const parentText = getText(dateElement.parentElement);
      const dateText = getText(dateElement);
      const remaining = parentText.replace(dateText, '').trim();

      if (remaining && remaining.length < 150) {
        return cleanVenueName(remaining);
      }
    }

    return '';
  }

  // 出演アーティストを取得
  function getArtists() {
    const artists = [
        ...document.querySelectorAll('h4.artistName2 a[href*="/artists/"]')
    ]
        .map(a => a.textContent.trim())
        .filter(Boolean);

    return [...new Set(artists)];
}function getArtists() {
    const artists = [
        ...document.querySelectorAll('h4.artistName2 a[href*="/artists/"]')
    ]
        .map(a => a.textContent.trim())
        .filter(Boolean);

    return [...new Set(artists)];
}

  // 公演情報をまとめる
  function collectEventData() {
    const dateTime = getDateAndTime();

    return {
      name: getEventName(),
      year: dateTime.year,
      month: dateTime.month,
      day: dateTime.day,
      time: dateTime.time,
      venue: getVenue(),
      artists: getArtists(),
      sourceUrl: location.href
    };
  }

  // MusicBrainzのイベント作成URLを作る
  function buildMusicBrainzUrl(data) {
    const params = new URLSearchParams();

    if (data.name) {
      params.set('edit-event.name', data.name);
    }

    if (data.year) {
      params.set(
        'edit-event.period.begin_date.year',
        data.year
      );
    }

    if (data.month) {
      params.set(
        'edit-event.period.begin_date.month',
        data.month
      );
    }

    if (data.day) {
      params.set(
        'edit-event.period.begin_date.day',
        data.day
      );
    }
// End dateもBegin dateと同じ日に設定
if (data.year) {
  params.set(
    'edit-event.period.end_date.year',
    data.year
  );
}

if (data.month) {
  params.set(
    'edit-event.period.end_date.month',
    data.month
  );
}

if (data.day) {
  params.set(
    'edit-event.period.end_date.day',
    data.day
  );
}
    if (data.time) {
      params.set('edit-event.time', data.time);
    }

    if (data.sourceUrl) {
      params.set(
        'edit-event.edit_note',
        `LiveFans to MusicBrainz Event Importer (https://github.com/yakumo0209/LiveFans-to-MusicBrainz-Event-Importer)
Source: ${data.sourceUrl}`
      );
    }

    // MusicBrainz側の補助スクリプトに渡す情報
    params.set('lfmb_venue', data.venue || '');
    params.set(
      'lfmb_artists',
      JSON.stringify(data.artists || [])
    );

    return `${MUSICBRAINZ_EVENT_URL}?${params.toString()}`;
  }

  // 情報確認パネルを表示
  function showPreview(data) {
    document.getElementById('lfmb-preview-panel')?.remove();

    const panel = document.createElement('div');
    panel.id = 'lfmb-preview-panel';

    Object.assign(panel.style, {
      position: 'fixed',
      right: '20px',
      bottom: '20px',
      zIndex: '999999',
      width: '340px',
      maxWidth: 'calc(100vw - 40px)',
      maxHeight: '75vh',
      overflowY: 'auto',
      padding: '16px',
      background: '#fff',
      color: '#222',
      border: '1px solid #888',
      borderRadius: '10px',
      boxShadow: '0 4px 18px rgba(0,0,0,.25)',
      fontSize: '14px',
      lineHeight: '1.5'
    });

    const heading = document.createElement('div');
    heading.textContent = 'Add Event';

    Object.assign(heading.style, {
      fontSize: '16px',
      fontWeight: 'bold',
      marginBottom: '10px'
    });

    panel.appendChild(heading);

    const fields = [
      ['イベント名 / Event Name', data.name],
      [
        '開催日 / Date',
        data.year && data.month && data.day
          ? `${data.year}-${data.month}-${data.day}`
          : '(取得できませんでした)'
      ],
      [
        '開演時刻 / Time',
        data.time || '(取得できませんでした)'
      ],
      [
        '会場 / Venue',
        data.venue || '(取得できませんでした)'
      ],
      [
        '出演者 / Performer',
        data.artists.join(', ') ||
          '(取得できませんでした)'
      ]
    ];

    for (const [label, value] of fields) {
      const row = document.createElement('div');
      row.style.marginBottom = '5px';

      const labelElement = document.createElement('strong');
      labelElement.textContent = `${label}：`;

      const valueElement = document.createElement('span');
      valueElement.textContent =
        value || '(取得できませんでした)';
      valueElement.style.overflowWrap = 'anywhere';

      row.append(labelElement, valueElement);
      panel.appendChild(row);
    }

    const note = document.createElement('div');

    Object.assign(note.style, {
      marginTop: '10px',
      fontSize: '12px',
      color: '#555'
    });

    panel.appendChild(note);

    const buttonContainer = document.createElement('div');

    Object.assign(buttonContainer.style, {
      display: 'flex',
      gap: '8px',
      marginTop: '12px'
    });

    const openButton = document.createElement('button');
    openButton.type = 'button';
    openButton.textContent = 'Open in MusicBrainz';

    Object.assign(openButton.style, {
      flex: '1',
      padding: '9px 10px',
      border: 'none',
      borderRadius: '6px',
      background: '#2867a5',
      color: '#fff',
      cursor: 'pointer',
      fontWeight: 'bold'
    });

    openButton.addEventListener('click', () => {
      GM_openInTab(buildMusicBrainzUrl(data), {
        active: true
      });
    });

    const closeButton = document.createElement('button');
    closeButton.type = 'button';
    closeButton.textContent = 'Close';

    Object.assign(closeButton.style, {
      padding: '9px 10px',
      border: '1px solid #aaa',
      borderRadius: '6px',
      background: '#f3f3f3',
      color: '#222',
      cursor: 'pointer'
    });

    closeButton.addEventListener('click', () => {
      panel.remove();
    });

    buttonContainer.append(openButton, closeButton);
    panel.appendChild(buttonContainer);
    document.body.appendChild(panel);
  }

  function init() {
    if (!location.pathname.startsWith('/events/')) {
      return;
    }

    const data = collectEventData();

    if (!data.name) {
      console.warn(
        '[LiveFans → MusicBrainz] イベント名を取得できませんでした。'
      );
    }

    showPreview(data);

    console.log(
      '[LiveFans → MusicBrainz] 取得した公演情報:',
      data
    );
  }

  init();
})();
